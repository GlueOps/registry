+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/distribution/distribution/v3"
+	"github.com/distribution/distribution/v3/internal/client/auth/challenge"
+	"github.com/distribution/distribution/v3/registry/storage"
+	"github.com/distribution/distribution/v3/registry/storage/driver/inmemory"
+	"github.com/distribution/reference"
+	"github.com/opencontainers/go-digest"
+	v1 "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+// fakeUpstream is a token-authenticated registry that can stop answering.
+type fakeUpstream struct {
+	srv *httptest.Server
+
+	hang      atomic.Bool // handlers block until the client gives up
+	hangToken atomic.Bool // only the token endpoint does
+	listDelay time.Duration
+	status    atomic.Int32 // if set, manifests get this status instead of 200
+	pings     atomic.Int32
+	requests  atomic.Int32
+
+	mu   sync.Mutex
+	tags map[string]digest.Digest
+}
+
+func newFakeUpstream(t *testing.T) *fakeUpstream {
+	t.Helper()
+	f := &fakeUpstream{tags: map[string]digest.Digest{"latest": digest.FromString("v1")}}
+	f.srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		f.requests.Add(1)
+		if f.hang.Load() {
+			<-r.Context().Done()
+			return
+		}
+		switch {
+		case r.URL.Path == "/v2/":
+			f.pings.Add(1)
+			w.Header().Set("WWW-Authenticate", `Bearer realm="`+f.srv.URL+`/token",service="fake"`)
+			w.WriteHeader(http.StatusUnauthorized)
+		case r.URL.Path == "/token":
+			if f.hangToken.Load() {
+				<-r.Context().Done()
+				return
+			}
+			_, _ = io.WriteString(w, `{"token":"t","expires_in":300}`)
+		case strings.HasSuffix(r.URL.Path, "/tags/list"):
+			if r.Header.Get("Authorization") != "Bearer t" {
+				w.WriteHeader(http.StatusUnauthorized)
+				return
+			}
+			time.Sleep(f.listDelay)
+			f.mu.Lock()
+			names := make([]string, 0, len(f.tags))
+			for name := range f.tags {
+				names = append(names, name)
+			}
+			f.mu.Unlock()
+			sort.Strings(names)
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = fmt.Fprintf(w, `{"name":"library/test","tags":["%s"]}`, strings.Join(names, `","`))
+		case strings.Contains(r.URL.Path, "/manifests/"):
+			if r.Header.Get("Authorization") != "Bearer t" {
+				w.WriteHeader(http.StatusUnauthorized)
+				return
+			}
+			if s := f.status.Load(); s != 0 {
+				w.WriteHeader(int(s))
+				return
+			}
+			f.mu.Lock()
+			dgst, ok := f.tags[r.URL.Path[strings.LastIndex(r.URL.Path, "/")+1:]]
+			f.mu.Unlock()
+			if !ok {
+				w.WriteHeader(http.StatusNotFound)
+				return
+			}
+			w.Header().Set("Content-Type", "application/vnd.oci.image.manifest.v1+json")
+			w.Header().Set("Docker-Content-Digest", dgst.String())
+			w.Header().Set("Content-Length", "2")
+			w.WriteHeader(http.StatusOK)
+			if r.Method != http.MethodHead {
+				_, _ = io.WriteString(w, "{}")
+			}
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	t.Cleanup(f.srv.Close)
+	return f
+}
+
+func (f *fakeUpstream) setTag(tag string, dgst digest.Digest) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.tags[tag] = dgst
+}
+
+// upstreamTestEnv is a proxy in front of fakeUpstream. restart returns a proxy
+// over the same local storage with an empty challenge manager, as a restarted
+// registry has.
+type upstreamTestEnv struct {
+	t           *testing.T
+	upstream    *fakeUpstream
+	local       distribution.Namespace
+	ctx         context.Context
+	challengers []*remoteAuthChallenger
+}
+
+func newUpstreamTestEnv(t *testing.T) *upstreamTestEnv {
+	t.Helper()
+	shortUpstreamTimeouts(t)
+	ctx := context.Background()
+	local, err := storage.NewRegistry(ctx, inmemory.New())
+	if err != nil {
+		t.Fatal(err)
+	}
+	e := &upstreamTestEnv{t: t, upstream: newFakeUpstream(t), local: local, ctx: ctx}
+	// A ping outlives the caller that started it; let it finish before the
+	// timeouts are restored and the upstream is closed.
+	t.Cleanup(e.waitForPings)
+	return e
+}
+
+func (e *upstreamTestEnv) waitForPings() {
+	deadline := time.Now().Add(oneTimeout)
+	for _, c := range e.challengers {
+		for {
+			c.Lock()
+			inflight := c.ping != nil
+			c.Unlock()
+			if !inflight || time.Now().After(deadline) {
+				break
+			}
+			time.Sleep(5 * time.Millisecond)
+		}
+	}
+}
+
+// shortUpstreamTimeouts makes waiting on the upstream take milliseconds.
+func shortUpstreamTimeouts(t *testing.T) {
+	t.Helper()
+	ping, tag, retry := upstreamPingTimeout, upstreamTagTimeout, upstreamRetryAfter
+	// retry: long enough that a test finishes its steps while still down.
+	upstreamPingTimeout, upstreamTagTimeout, upstreamRetryAfter = 200*time.Millisecond, 200*time.Millisecond, 5*time.Second
+	t.Cleanup(func() { upstreamPingTimeout, upstreamTagTimeout, upstreamRetryAfter = ping, tag, retry })
+}
+
+func (e *upstreamTestEnv) restart() (distribution.TagService, *remoteAuthChallenger) {
+	e.t.Helper()
+	u, err := url.Parse(e.upstream.srv.URL)
+	if err != nil {
+		e.t.Fatal(err)
+	}
+	c := &remoteAuthChallenger{remoteURL: *u, cm: challenge.NewSimpleManager(), cs: credentials{}}
+	e.challengers = append(e.challengers, c)
+	return e.request(c), c
+}
+
+// request returns the tag service a new HTTP request would get: a new
+// repository, with its own token handler, sharing the registry's challenger.
+func (e *upstreamTestEnv) request(c *remoteAuthChallenger) distribution.TagService {
+	e.t.Helper()
+	pr := &proxyingRegistry{embedded: e.local, remoteURL: c.remoteURL, authChallenger: c, basicAuth: userpass{}}
+	name, _ := reference.WithName("library/test")
+	repo, err := pr.Repository(e.ctx, name)
+	if err != nil {
+		e.t.Fatal(err)
+	}
+	return repo.Tags(e.ctx)
+}
+
+// warm pulls the tag while the upstream answers, so it is cached locally.
+func (e *upstreamTestEnv) warm(tags distribution.TagService, tag string) digest.Digest {
+	e.t.Helper()
+	desc, err := tags.Get(e.ctx, tag)
+	if err != nil {
+		e.t.Fatalf("warm-up Get: %v", err)
+	}
+	return desc.Digest
+}
+
+// upstreamDown reports whether a network failure is currently remembered,
+// without the probe bookkeeping of skipUpstream.
+func (r *remoteAuthChallenger) upstreamDown() bool {
+	r.Lock()
+	defer r.Unlock()
+	return r.downLocked()
+}
+
+func timed(t *testing.T, f func()) time.Duration {
+	t.Helper()
+	start := time.Now()
+	f()
+	return time.Since(start)
+}
+
+// A bound on how long an operation that waits out one upstream timeout may
+// take, generous for -race and slow CI.
+const oneTimeout = 2 * time.Second
+
+func TestCachedTagServedAfterRestartWhileUpstreamHangs(t *testing.T) {
+	env := newUpstreamTestEnv(t)
+	tags, _ := env.restart()
+	want := env.warm(tags, "latest")
+
+	env.upstream.hang.Store(true)
+	tags, c := env.restart()
+	before := env.upstream.requests.Load()
+
+	var desc v1.Descriptor
+	var err error
+	took := timed(t, func() { desc, err = tags.Get(env.ctx, "latest") })
+	if err != nil || desc.Digest != want {
+		t.Fatalf("Get: %v, digest %s, want %s", err, desc.Digest, want)
+	}
+	if took > oneTimeout {
+		t.Fatalf("Get took %s, want at most one upstream timeout", took)
+	}
+	if !c.upstreamDown() {
+		t.Fatal("upstream not remembered as down after the ping timed out")
+	}
+	if got := env.upstream.requests.Load() - before; got != 1 {
+		t.Fatalf("upstream got %d requests, want 1 (the ping)", got)
+	}
+}
+
+func TestConcurrentCallersShareOnePing(t *testing.T) {
+	env := newUpstreamTestEnv(t)
+	tags, _ := env.restart()
+	want := env.warm(tags, "latest")
+
+	env.upstream.hang.Store(true)
+	tags, _ = env.restart()
+	before := env.upstream.requests.Load()
+
+	const n = 5
+	var wg sync.WaitGroup
+	errs := make([]error, n)
+	took := timed(t, func() {
+		for i := range n {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				desc, err := tags.Get(env.ctx, "latest")
+				if err == nil && desc.Digest != want {
+					err = fmt.Errorf("digest %s, want %s", desc.Digest, want)
+				}
+				errs[i] = err
+			}()
+		}
+		wg.Wait()
+	})
+	for i, err := range errs {
+		if err != nil {
+			t.Errorf("caller %d: %v", i, err)
+		}
+	}
+	if took > oneTimeout {
+		t.Fatalf("%d concurrent Gets took %s, want at most one upstream timeout", n, took)
+	}
+	if got := env.upstream.requests.Load() - before; got != 1 {
+		t.Fatalf("upstream got %d requests, want 1 shared ping", got)
+	}
+}
+
+func TestCachedTagServedWithoutUpstreamWhileDown(t *testing.T) {
+	env := newUpstreamTestEnv(t)
+	tags, c := env.restart()
+	want := env.warm(tags, "latest")
+

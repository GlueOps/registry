+// When the memory expires during a long outage, one caller asks the upstream
+// and the others keep serving the cache, so they don't all wait on it.
+func TestOneProbeAfterRetryWindow(t *testing.T) {
+	env := newUpstreamTestEnv(t)
+	tags, c := env.restart()
+	want := env.warm(tags, "latest")
+
+	env.upstream.hang.Store(true)
+	_, _ = tags.Get(env.ctx, "latest")
+	if !c.upstreamDown() {
+		t.Fatal("upstream not remembered as down")
+	}
+	c.Lock()
+	c.failedAt = time.Now().Add(-upstreamRetryAfter) // the memory has just expired
+	c.Unlock()
+	before := env.upstream.requests.Load()
+
+	const n = 5
+	var wg sync.WaitGroup
+	slow := make([]bool, n)
+	for i := range n {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			var desc v1.Descriptor
+			var err error
+			took := timed(t, func() { desc, err = tags.Get(env.ctx, "latest") })
+			if err != nil || desc.Digest != want {
+				t.Errorf("caller %d: %v, digest %s, want %s", i, err, desc.Digest, want)
+			}
+			slow[i] = took >= upstreamTagTimeout
+		}()
+	}
+	wg.Wait()
+	var probes int
+	for _, s := range slow {
+		if s {
+			probes++
+		}
+	}
+	if probes != 1 {
+		t.Fatalf("%d callers waited on the upstream, want 1", probes)
+	}
+	if got := env.upstream.requests.Load() - before; got != 1 {
+		t.Fatalf("upstream got %d requests, want 1 probe", got)
+	}
+	if !c.upstreamDown() {
+		t.Fatal("the failed probe was not remembered")
+	}
+}

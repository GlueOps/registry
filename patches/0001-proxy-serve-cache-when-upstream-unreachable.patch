+// One caller giving up on the shared ping must not fail the others, and the
+// ping must still record its result.
+func TestPingOutlivesCallerThatGaveUp(t *testing.T) {
+	env := newUpstreamTestEnv(t)
+	tags, _ := env.restart()
+	want := env.warm(tags, "latest")
+
+	env.upstream.hang.Store(true)
+	tags, c := env.restart()
+	ctx, cancel := context.WithCancel(env.ctx)
+	go func() {
+		time.Sleep(20 * time.Millisecond)
+		cancel()
+	}()
+
+	var patient v1.Descriptor
+	var patientErr error
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		patient, patientErr = tags.Get(env.ctx, "latest")
+	}()
+
+	var err error
+	took := timed(t, func() { _, err = tags.Get(ctx, "missing") })
+	if _, ok := err.(distribution.ErrTagUnknown); !ok {
+		t.Fatalf("Get: %v (%T), want ErrTagUnknown from the local fallback", err, err)
+	}
+	if took >= upstreamPingTimeout {
+		t.Fatalf("Get took %s: the caller waited for the ping instead of returning when it gave up", took)
+	}
+	if c.upstreamDown() {
+		t.Fatal("marked down before the ping finished")
+	}
+
+	wg.Wait()
+	if patientErr != nil || patient.Digest != want {
+		t.Fatalf("the caller that waited got %v, digest %s, want %s", patientErr, patient.Digest, want)
+	}
+	if !c.upstreamDown() {
+		t.Fatal("the detached ping did not record its failure")
+	}
+	if n := env.upstream.pings.Load(); n != 1 {
+		t.Fatalf("upstream saw %d pings, want the warm-up one only (the outage ping hangs before counting)", n)
+	}
+}

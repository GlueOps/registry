+// After a restart during an outage the memory is set by the ping; the first
+// successful ping clears it.
+func TestSuccessfulPingClearsFailure(t *testing.T) {
+	env := newUpstreamTestEnv(t)
+	tags, _ := env.restart()
+	env.warm(tags, "latest")

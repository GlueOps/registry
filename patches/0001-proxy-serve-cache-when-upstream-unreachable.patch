+func TestUpstreamUnreachable(t *testing.T) {
+	for name, tc := range map[string]struct {
+		err  error
+		want bool
+	}{
+		"nil":                       {nil, false},
+		"deadline":                  {context.DeadlineExceeded, true},
+		"wrapped deadline":          {&url.Error{Op: "Get", Err: &url.Error{Op: "Get", Err: context.DeadlineExceeded}}, true},
+		"dial refused":              {&url.Error{Op: "Get", Err: &net.OpError{Op: "dial", Err: errors.New("connection refused")}}, true},
+		"dns":                       {&url.Error{Op: "Get", Err: &net.DNSError{Err: "no such host", IsNotFound: true}}, true},
+		"client timeout":            {&url.Error{Op: "Get", Err: &timeoutErr{}}, true},
+		"http error":                {errors.New("unexpected status code 500 Internal Server Error"), false},
+		"token error via transport": {&url.Error{Op: "Head", Err: errors.New("authorization server did not include a token in the response")}, false},
+		"canceled":                  {&url.Error{Op: "Get", Err: context.Canceled}, false},
+	} {
+		if got := upstreamUnreachable(tc.err); got != tc.want {
+			t.Errorf("%s: got %v, want %v", name, got, tc.want)
+		}
+	}
+}
+
+type timeoutErr struct{}
+
+func (*timeoutErr) Error() string   { return "i/o timeout" }
+func (*timeoutErr) Timeout() bool   { return true }
+func (*timeoutErr) Temporary() bool { return true }

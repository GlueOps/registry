+	}
+	if took > oneTimeout {
+		t.Fatalf("Get took %s, want at most one upstream timeout", took)
+	}
+	if !c.upstreamDown() {
+		t.Fatal("upstream not remembered as down after the lookup timed out")
+	}
+
+	before := env.upstream.requests.Load()
+	took = timed(t, func() { desc, err = tags.Get(env.ctx, "latest") })
+	if err != nil || desc.Digest != want {
+		t.Fatalf("Get: %v, digest %s, want %s", err, desc.Digest, want)
+	}
+	if took > oneTimeout {
+		t.Fatalf("Get took %s while upstream is known to be down", took)
+	}
+	if got := env.upstream.requests.Load() - before; got != 0 {
+		t.Fatalf("upstream got %d requests while known to be down, want 0", got)
+	}
+
+	// Once the failure is forgotten, the upstream is asked again.
+	upstreamRetryAfter = 0
+	if _, err := tags.Get(env.ctx, "latest"); err != nil {
+		t.Fatalf("Get after retry window: %v", err)
+	}
+	if got := env.upstream.requests.Load() - before; got == 0 {
+		t.Fatal("upstream was not asked again after the retry window")
+	}
+}

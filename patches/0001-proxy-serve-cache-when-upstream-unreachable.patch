+	env.upstream.hang.Store(true)
+	tags, c := env.restart()
+	_, _ = tags.Get(env.ctx, "latest")
+	if !c.upstreamDown() {
+		t.Fatal("upstream not remembered as down after the ping timed out")
+	}
+
+	env.upstream.hang.Store(false)
+	if _, err := tags.Get(env.ctx, "missing"); err == nil {
+		t.Fatal("Get of a missing tag succeeded")
+	}
+	if c.upstreamDown() {
+		t.Fatal("still down after a successful ping")
+	}
+}

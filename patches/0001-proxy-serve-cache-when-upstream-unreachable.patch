+func TestSuccessClearsFailureImmediately(t *testing.T) {
+	env := newUpstreamTestEnv(t)
+	tags, c := env.restart()
+	env.warm(tags, "latest")
+
+	env.upstream.hang.Store(true)
+	_, _ = tags.Get(env.ctx, "latest")
+	if !c.upstreamDown() {
+		t.Fatal("upstream not remembered as down")
+	}
+
+	env.upstream.hang.Store(false)
+	env.upstream.setTag("other", digest.FromString("other"))
+	if _, err := tags.Get(env.ctx, "other"); err != nil {
+		t.Fatalf("Get after recovery: %v", err)
+	}
+	if c.upstreamDown() {
+		t.Fatal("still down after a successful request")
+	}
+
+	// A cached tag is now looked up upstream again and picks up a change.
+	changed := digest.FromString("v2")
+	env.upstream.setTag("latest", changed)
+	desc, err := tags.Get(env.ctx, "latest")
+	if err != nil || desc.Digest != changed {
+		t.Fatalf("Get after recovery: %v, digest %s, want %s", err, desc.Digest, changed)
+	}
+}
